shader no_derivs(string filename = "ramp.env", vector direction = vector(1, 1, 1),
                 int explicit_derivs = 0, output color Cout = 0)
{
    if (explicit_derivs)
        Cout = environment(filename, direction, vector(0), vector(0));
    else
        Cout = environment(filename, direction);
}
